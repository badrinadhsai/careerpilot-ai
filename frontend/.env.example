# CareerPilot AI — frontend environment (public values only).
# Copy to .env in this folder for local development. Never put secrets here:
# NO service-role keys, NO Gemini/LLM keys. Those are backend-only.

# Your Supabase project URL (public, bare project URL — no /rest/v1 suffix).
# Get it from: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=

# Your Supabase publishable/anon key (public, safe for browsers).
VITE_SUPABASE_ANON_KEY=

# Backend API origin (production: Render URL; local dev: leave empty to use
# the Vite dev-server proxy in vite.config.js). Both forms are accepted:
#   VITE_API_URL=https://your-backend.onrender.com
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
